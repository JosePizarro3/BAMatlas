DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=bamatlas.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://bamatlas.example.org
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

DATABASE_URL=postgresql://bamatlas:replace-this-password@db.example.org:5432/bamatlas

ACCOUNT_ALLOWED_EMAIL_DOMAINS=bam.de
ACCOUNT_REQUIRE_ADMIN_APPROVAL=true

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@bamatlas.example.org

WEB_CONCURRENCY=2
