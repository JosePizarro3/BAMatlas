DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-compose-dev-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

DATABASE_URL=postgresql://bamatlas:bamatlas@db:5432/bamatlas

ACCOUNT_ALLOWED_EMAIL_DOMAINS=bam.de
ACCOUNT_REQUIRE_ADMIN_APPROVAL=true

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@bamatlas.local

WEB_CONCURRENCY=2
